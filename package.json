{
  "name": "urban-alert-platform",
  "version": "0.1.0",
  "description": "Urban Alert Platform (App Cảnh Báo Đô Thị) — backend monorepo",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "build": "yarn build:api-gateway && yarn build:auth-service && yarn build:user-service && yarn build:incident-service && yarn build:moderation-service && yarn build:notification-service",
    "build:api-gateway": "nest build api-gateway",
    "build:auth-service": "nest build auth-service",
    "build:user-service": "nest build user-service",
    "build:incident-service": "nest build incident-service",
    "build:moderation-service": "nest build moderation-service",
    "build:notification-service": "nest build notification-service",
    "dev": "concurrently -k -n gateway,auth,user,moderation,notification -c cyan,green,yellow,magenta,blue,red \"nest start api-gateway --watch\" \"nest start auth-service --watch\" \"nest start user-service --watch\"  \"nest start moderation-service --watch\" \"nest start notification-service --watch\"",
    "dev:api-gateway": "nest start api-gateway --watch",
    "dev:auth-service": "nest start auth-service --watch",
    "dev:user-service": "nest start user-service --watch",
    "dev:incident-service": "nest start incident-service --watch",
    "dev:moderation-service": "nest start moderation-service --watch",
    "dev:notification-service": "nest start notification-service --watch",
    "start:prod": "node dist/apps/${APP:?set APP to a service name}/main.js",
    "lint": "eslint \"{apps,libs,prisma,test}/**/*.ts\"",
    "lint:fix": "eslint \"{apps,libs,prisma,test}/**/*.ts\" --fix",
    "format": "prettier --write \"{apps,libs,prisma,test}/**/*.ts\" \"*.{json,md,yml}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"{apps,libs,prisma,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:integration": "jest --config test/jest-integration.json --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "db:grants": "docker compose exec -T postgres bash /docker-entrypoint-initdb.d/20-roles-and-schemas.sh",
    "db:reset": "prisma migrate reset --force && yarn db:grants",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:verify": "bash infrastructure/scripts/verify-infra.sh"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "ts-node --transpile-only --project tsconfig.json prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "http-proxy-middleware": "3.0.10",
    "ioredis": "5.11.1",
    "kafkajs": "2.2.4",
    "nestjs-pino": "4.6.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.8",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "concurrently": "9.2.5",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "light-my-request": "6.6.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "prisma": "6.19.3",
    "ts-jest": "29.4.15",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "webpack": "5.112.2"
  }
}
