# Copy to `.env` for local development: cp .env.example .env
# Every value below is a LOCAL DEVELOPMENT default. Never reuse these in a deployed environment.

NODE_ENV=development
LOG_LEVEL=info
# Human-readable logs (pino-pretty). Use false to get JSON lines.
LOG_PRETTY=true
SWAGGER_ENABLED=true
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Docker Compose infrastructure (docker-compose.yml)
# ---------------------------------------------------------------------------
POSTGRES_USER=urban_admin
POSTGRES_PASSWORD=urban_admin_dev
POSTGRES_DB=urban_alert
POSTGRES_PORT=5432
SERVICE_DB_PASSWORD=service_dev_password
REDIS_PORT=6379
KAFKA_PORT=9092
KAFKA_UI_PORT=8080
KAFKA_TOPIC_PARTITIONS=3

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Owner role: used only by the Prisma CLI (migrate, seed, studio).
MIGRATION_DATABASE_URL=postgresql://urban_admin:urban_admin_dev@localhost:5432/urban_alert

# Per-service least-privileged roles (created by infrastructure/postgres/init).
# In containers you can set DATABASE_URL instead; the prefixed form wins when both exist.
AUTH_SERVICE_DATABASE_URL=postgresql://auth_service:service_dev_password@localhost:5432/urban_alert
USER_SERVICE_DATABASE_URL=postgresql://user_service:service_dev_password@localhost:5432/urban_alert
INCIDENT_SERVICE_DATABASE_URL=postgresql://incident_service:service_dev_password@localhost:5432/urban_alert
MODERATION_SERVICE_DATABASE_URL=postgresql://moderation_service:service_dev_password@localhost:5432/urban_alert
NOTIFICATION_SERVICE_DATABASE_URL=postgresql://notification_service:service_dev_password@localhost:5432/urban_alert

# ---------------------------------------------------------------------------
# Service ports and URLs (PORT can replace the prefixed form in containers)
# ---------------------------------------------------------------------------
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
INCIDENT_SERVICE_PORT=3003
MODERATION_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005

AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
INCIDENT_SERVICE_URL=http://localhost:3003
MODERATION_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Generate real secrets with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=urban-alert-auth
JWT_AUDIENCE=urban-alert-api
# Shared key for service-to-service calls on /internal/* routes.
INTERNAL_API_KEY=dev-only-internal-api-key-change-me

# ---------------------------------------------------------------------------
# Redis / Kafka
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_MAX_RETRIES=3
KAFKAJS_NO_PARTITIONER_WARNING=1

# ---------------------------------------------------------------------------
# Feature settings
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
INCIDENT_CACHE_TTL_SECONDS=60
DUPLICATE_RADIUS_METERS=200
DUPLICATE_WINDOW_MINUTES=60

# ---------------------------------------------------------------------------
# Firebase Cloud Messaging (optional). Leave empty to use the mock push provider.
# ---------------------------------------------------------------------------
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Private key from the service-account JSON, with newlines escaped as \n.
FCM_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Optional image overrides (docker-compose.yml)
# ---------------------------------------------------------------------------
# postgis/postgis is amd64-only and runs under Rosetta on Apple Silicon. For native arm64:
# POSTGIS_IMAGE=imresamu/postgis:16-3.5
# POSTGIS_PLATFORM=linux/arm64
